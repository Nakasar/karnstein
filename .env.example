# --- Base de données ---------------------------------------------------
# Chaîne de connexion MongoDB (local, Docker ou Atlas).
DATABASE_URL="mongodb://127.0.0.1:27017"
# Nom de la base utilisée par le site.
MONGODB_DB="karnstein"
# Passer à "true" uniquement si l'instance MongoDB est un replica set :
# les transactions échouent sur une instance standalone.
MONGODB_TRANSACTIONS="false"

# --- better-auth -------------------------------------------------------
# Secret de signature des sessions. À générer : openssl rand -base64 32
BETTER_AUTH_SECRET=""
# URL publique du site (sans slash final).
BETTER_AUTH_URL="http://localhost:3000"
